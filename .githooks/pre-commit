#!/usr/bin/env bash
#
# Local quality gate.
#
# Runs only the fast checks — the ones that take seconds and catch the
# mistakes that otherwise land on GitHub: formatting, linting, and type
# checking. Long-running work (unit/integration/E2E suites, bundle budgets,
# visual baselines) is deliberately NOT here: those are CI's job and they
# would make committing unbearable.
#
# Every check is scoped to the staged work where the tool supports it, so a
# commit in a monorepo does not pay for the whole tree.
#
# Bypass for an emergency:  git commit --no-verify
set -uo pipefail

repo_root="$(git rev-parse --show-toplevel)"
cd "$repo_root"

# Keep the hook silent when there is nothing staged to judge.
if ! git diff --cached --quiet; then
  # Original whitespace-error guard, preserved.
  git diff --cached --check || exit 1
fi

staged_files="$(git diff --cached --name-only --diff-filter=ACMR)"
[ -z "$staged_files" ] && exit 0

# Only gate on files this repo's tooling actually owns.
status=0
note() { printf '\033[1m[pre-commit]\033[0m %s\n' "$1"; }
fail() { printf '\033[31m[pre-commit] FAILED:\033[0m %s\n' "$1" >&2; status=1; }

# ---------------------------------------------------------------- format ----
formattable="$(printf '%s\n' "$staged_files" \
  | grep -E '\.(ts|tsx|js|jsx|mjs|cjs|css|json|md|mdx)$' || true)"
if [ -n "$formattable" ]; then
  unformatted="$(printf '%s\n' "$formattable" | xargs bunx oxfmt --check 2>&1)" || {
    note 'formatting drifted — run `bun run fmt` to fix'
    printf '%s\n' "$unformatted" >&2
    fail 'format:check'
  }
fi

# ------------------------------------------------------------------ lint ----
# oxlint reads .oxlintrc.json for its own scoping, so linting the staged
# files directly honours the per-path overrides (the ratchet block).
#
# `|| true` matters: grep exits 1 when nothing matches, and with pipefail
# that would otherwise read as a lint failure on e.g. a CSS-only commit.
lintable="$(printf '%s\n' "$staged_files" | grep -E '\.(ts|tsx|js|jsx|mjs|cjs)$' || true)"
if [ -n "$lintable" ]; then
  lintout="$(printf '%s\n' "$lintable" | xargs bunx oxlint --deny-warnings 2>&1)" || {
    note 'lint errors — fix these before committing'
    printf '%s\n' "$lintout" >&2
    fail 'lint'
  }
fi

# ------------------------------------------------------------- typecheck ----
# Only when the commit can affect a typed package; a full `turbo typecheck`
# is still fast enough (seconds) with a warm cache and catches the class of
# error that produced the last two CI failures on its own.
if printf '%s\n' "$staged_files" | grep -qE '\.(ts|tsx)$'; then
  note 'type checking (turbo)…'
  if ! bunx turbo run typecheck --filter='...[origin/main]' >/tmp/pre-commit-typecheck.log 2>&1; then
    # Filter to just the merge base can be empty on a fresh branch; fall back
    # to the whole tree rather than letting a real error through.
    if ! bunx turbo run typecheck >>/tmp/pre-commit-typecheck.log 2>&1; then
      note 'type errors — see /tmp/pre-commit-typecheck.log'
      grep -E 'error TS|exited with code' /tmp/pre-commit-typecheck.log | head -20 >&2
      fail 'typecheck'
    fi
  fi
fi

if [ "$status" -ne 0 ]; then
  cat >&2 <<'EOF'

[pre-commit] Fix the above, or stage less and commit in smaller steps.
Emergency escape hatch: git commit --no-verify
EOF
  exit 1
fi

note 'format, lint, and typecheck passed'
exit 0
