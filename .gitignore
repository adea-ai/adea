# Repository-specific rules
# Operating system
.DS_Store
Thumbs.db
.Trashes

# Secrets and local environment
.env
.env.*
!.env.example
*.pem
*.key

# JavaScript and TypeScript
node_modules/
.pnp/
.pnp.js
.turbo/
*.tsbuildinfo
next-env.d.ts

# Python
.venv/
venv/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.mypy_cache/

# Rust
target/
# Tauri generates capability/ACL schemas here on dev/build; never commit.
apps/desktop/src-tauri/gen/

# Build and test output
dist/
build/
out/
coverage/
htmlcov/
.coverage*
.next/
/.artifacts/
test-results/

# Cloudflare Workers (OpenNext)
.open-next/
.wrangler/
.dev.vars
cloudflare-env.d.ts

# Engine binaries are never tracked here. The spatial engine and its binary
# art live in the private agent-sim repo (assets in adea-ai/assets); this
# repository ships manifests only. No 3D/audio authoring binary may ever be
# tracked anywhere, regardless of directory.
*.glb
*.gltf
*.fbx
*.obj
*.blend

# Generated web assets (rebuilt by scripts/sync-assets.mjs)
apps/*/public/assets/
# Transient swap backups from scripts/sync-assets.mjs (removed on success,
# orphaned only if a run is interrupted); never commit.
apps/*/public/assets.backup-*/
# Mobile shell: apps/mobile/www/index.html is a tracked placeholder. Never
# commit a built web bundle there (a build could stage private pack bytes).
apps/mobile/www/**/*
!apps/mobile/www/index.html
cache/
!.github/actions/cache/
!.github/actions/cache/action.yml
typechain/
coverage.json
tests/.bin/
**/.app/

# Logs and temporary files
*.log
*.tmp
*.pid
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# Editors, agents, and local tools
.claude/
.kilo/
.codex/
.cursor/
.windsurf/
.vscode/
.idea/
.zed/
.fleet/
.opencode/
.kluster/
.direnv/
.envrc
mise.local.toml
.mise.local.toml
mise.local.lock
.mise.local.lock
*.code-workspace
