{
  "semi": false,
  "singleQuote": true,
  "trailingComma": "es5",
  "printWidth": 100,
  "ignorePatterns": [
    "CHANGELOG.md",
    ".github/.code-foundry",
    ".github/actions/",
    "plugin.json",
    ".github/workflows/validation.yml",
    ".github/workflows/release.yml",
    ".github/workflows/opencode-security.yml",
    ".github/ISSUE_TEMPLATE/bug_report.yml",
    ".github/ISSUE_TEMPLATE/feature_request.yml",
    ".github/actions",
    ".agents",
    "vendor/glib-0.18.5/README.md",
    ".next",
    "dist",
    "cloudflare-env.d.ts",
    "**/routeTree.gen.ts",
    "**/build",
    "node_modules",
    ".bun-cache-release",
    "bun.lock",
    "apps/*/public/assets",
    "apps/mobile/android/app/src/main/assets",
    "apps/mobile/ios/App/App/Assets.xcassets",
    "apps/mobile/ios/App/App/public",
    "apps/mobile/**/capacitor.config.json",
    "vendor/**"
  ]
}
