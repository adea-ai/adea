{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "jsPlugins": ["@shadcn/lint", "@adea-ai/ui/lint"],
  "settings": {
    "shadcn": {
      "ui": ["@adea-ai/app-ui/components", "@adea-ai/ui/components", "@adea-ai/workspace-ui"],
      "componentImports": ["^#components/"],
      "note": "Design-system rules cover both @adea-ai/app-ui (Adea legacy adapters) and @adea-ai/ui (published shared components). See packages/ui/src/styles/theme.css for colors."
    }
  },
  "categories": {
    "correctness": "error",
    "suspicious": "error"
  },
  "rules": {
    "shadcn/no-restyle": [
      "error",
      {
        "allow": [
          "layout",
          "conventional-*",
          "dev-*",
          "global-*",
          "plugin-*",
          "plugins-*",
          "virtual-*",
          "workspace-*"
        ]
      }
    ],
    "shadcn/no-raw-colors": [
      "error",
      {
        "scanAllStrings": true
      }
    ],
    "no-restricted-imports": [
      "error",
      {
        "patterns": [
          {
            "group": [
              "react",
              "react/*",
              "react-dom",
              "react-dom/*",
              "@radix-ui/*",
              "@base-ui-components/*",
              "@ark-ui/*",
              "@zag-js/*",
              "react-aria*",
              "@tanstack/react-*",
              "vaul",
              "sonner",
              "next-themes",
              "lucide-react"
            ],
            "message": "This is a Solid codebase \u2014 React libraries will not run. Use @adea-ai/app-ui components (@kobalte/core and @corvu primitives) and lucide-solid."
          }
        ]
      }
    ],
    "no-underscore-dangle": [
      "error",
      {
        "allow": [
          "__ADEA_DESKTOP_CLOUD_ORIGIN__",
          "__ADEA_DESKTOP_COMPONENTS__",
          "__ADEA_DEV_SCOPE__",
          "__ADEA_INITIAL_HASH__",
          "__ADEA_NAVIGATION_START__",
          "__ADEA_RELEASE__",
          "__ADEA_SCENE_TELEMETRY_ENDPOINT__",
          "__ADEA_THEME_LIBRARY__",
          "__adeaAgentSim",
          "__adeaDesktop",
          "__adeaTerminalPaneHarness",
          "__agentHqSound",
          "__TSR_index"
        ]
      }
    ],
    "shadcn/no-arbitrary-values": [
      "error",
      {
        "scanAllStrings": true
      }
    ],
    "shadcn/no-inline-styles": "error",
    "shadcn/no-unknown-classes": [
      "error",
      {
        "allow": [
          "conventional-*",
          "dev-*",
          "global-*",
          "plugin-*",
          "plugins-*",
          "virtual-*",
          "visually-hidden",
          "workspace-*"
        ]
      }
    ],
    "shadcn/require-static-classes": "error",
    "adea/no-raw-interactive-elements": "error",
    "adea/no-primitive-library-imports": "error"
  },
  "overrides": [
    {
      "files": [
        "apps/web/e2e/helpers/global-workspace-rail-harness-app.tsx",
        "apps/web/e2e/helpers/private-message-harness-app.tsx",
        "apps/web/e2e/helpers/workspace-form-harness-app.tsx",
        "apps/web/e2e/helpers/workspace-tooltip-harness-app.tsx",
        "apps/web/e2e/helpers/workspace-updates-harness-app.tsx",
        "apps/web/src/components/desktop-auth-complete.tsx",
        "apps/web/src/components/desktop-workspace-entry.tsx",
        "apps/web/src/components/sign-in-form.tsx",
        "packages/audio/src/sound.tsx",
        "packages/dev-view/src/agents/harness-status-pane.tsx",
        "packages/dev-view/src/appearance/appearance-surface.tsx",
        "packages/dev-view/src/browser/browser-pane.tsx",
        "packages/dev-view/src/browser/cookie-import-panel.tsx",
        "packages/dev-view/src/browser/mini-preview.tsx",
        "packages/dev-view/src/chat/chat-composer.tsx",
        "packages/dev-view/src/chat/chat-transcript.tsx",
        "packages/dev-view/src/chat/chat-view.tsx",
        "packages/dev-view/src/chat/onboarding/first-run-onboarding.tsx",
        "packages/dev-view/src/chat/search/chat-history-search.tsx",
        "packages/dev-view/src/computeruse/computeruse-pane.tsx",
        "packages/dev-view/src/dev-workspace-entry.tsx",
        "packages/dev-view/src/devices/devices-pane.tsx",
        "packages/dev-view/src/editor/code-editor.tsx",
        "packages/dev-view/src/files/files-pane.tsx",
        "packages/dev-view/src/history/run-history-pane.tsx",
        "packages/dev-view/src/resources/activity-pane.tsx",
        "packages/dev-view/src/resources/resources-pane.tsx",
        "packages/dev-view/src/sidebar/add-project-form.tsx",
        "packages/dev-view/src/sidebar/archive-shelf.tsx",
        "packages/dev-view/src/sidebar/dev-sidebar-shell.tsx",
        "packages/dev-view/src/sidebar/repo-registry-panel.tsx",
        "packages/dev-view/src/source-control/source-control-pane.tsx",
        "packages/dev-view/src/terminal/fixture-terminal-pane.tsx",
        "packages/dev-view/src/terminal/terminal-pane.tsx",
        "packages/ui/src/components/on-screen-controls.tsx",
        "packages/ui/src/components/theme-toggle.tsx",
        "packages/workspace-ui/src/agent-roster.tsx",
        "packages/workspace-ui/src/app-library-page.tsx",
        "packages/workspace-ui/src/artifact-detail.tsx",
        "packages/workspace-ui/src/conventional-workspace-shell.tsx",
        "packages/workspace-ui/src/conversation-surface.tsx",
        "packages/workspace-ui/src/create-workspace-dialogs.tsx",
        "packages/workspace-ui/src/message-composer.tsx",
        "packages/workspace-ui/src/message-row.tsx",
        "packages/workspace-ui/src/plugins-dialog.tsx",
        "packages/workspace-ui/src/sidebar-toggle-button.tsx",
        "packages/workspace-ui/src/task-board.tsx",
        "packages/workspace-ui/src/task-detail.tsx",
        "packages/workspace-ui/src/thread-panel.tsx",
        "packages/workspace-ui/src/virtual-room-controls.tsx",
        "packages/workspace-ui/src/workspace-settings.tsx",
        "packages/workspace-ui/src/workspace-sidebar.tsx",
        "packages/workspace-ui/src/workspace-states.tsx",
        "packages/workspace-ui/src/workspace-utility-dialogs.tsx"
      ],
      "rules": {
        "adea/no-raw-interactive-elements": "off",
        "adea/no-primitive-library-imports": "off"
      }
    },
    {
      "files": ["packages/ui/src/components/**"],
      "rules": {
        "shadcn/no-restyle": "off",
        "shadcn/no-arbitrary-values": "off",
        "shadcn/no-inline-styles": "off",
        "shadcn/require-static-classes": "off"
      }
    }
  ],
  "ignorePatterns": [
    "node_modules/**",
    ".wrangler/**",
    ".turbo/**",
    ".vite/**",
    "**/routeTree.gen.ts",
    "dist/**",
    "out/**",
    "build/**",
    "coverage/**"
  ]
}
