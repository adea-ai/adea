{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "jsPlugins": ["@shadcn/lint"],
  "settings": {
    "shadcn": {
      "ui": ["@adea-ai/ui/components", "@adea-ai/workspace-ui"],
      "componentImports": ["^#components/"],
      "note": "Design-system rules: use variants and theme tokens from packages/ui. See packages/ui/src/styles/theme.css for colors."
    }
  },
  "categories": {
    "correctness": "error",
    "suspicious": "error"
  },
  "rules": {
    "shadcn/no-restyle": [
      "error",
      {
        "allow": [
          "layout",
          "conventional-*",
          "dev-*",
          "global-*",
          "plugin-*",
          "plugins-*",
          "virtual-*",
          "visually-hidden",
          "workspace-*"
        ]
      }
    ],
    "shadcn/no-raw-colors": ["error", { "scanAllStrings": true }],
    "no-restricted-imports": [
      "error",
      {
        "patterns": [
          {
            "group": [
              "react",
              "react/*",
              "react-dom",
              "react-dom/*",
              "@radix-ui/*",
              "@base-ui-components/*",
              "@ark-ui/*",
              "@zag-js/*",
              "react-aria*",
              "@tanstack/react-*",
              "vaul",
              "sonner",
              "next-themes",
              "lucide-react"
            ],
            "message": "This is a Solid codebase — React libraries will not run. Use @adea-ai/ui components (@kobalte/core and @corvu primitives) and lucide-solid."
          }
        ]
      }
    ],
    "no-underscore-dangle": [
      "error",
      {
        "allow": [
          "__ADEA_DESKTOP_CLOUD_ORIGIN__",
          "__ADEA_NAVIGATION_START__",
          "__ADEA_RELEASE__",
          "__ADEA_SCENE_TELEMETRY_ENDPOINT__",
          "__adeaAgentSim",
          "__adeaDesktop",
          "__agentHqSound"
        ]
      }
    ],
    "shadcn/no-arbitrary-values": ["error", { "scanAllStrings": true }],
    "shadcn/no-inline-styles": "error",
    "shadcn/no-unknown-classes": [
      "error",
      {
        "allow": [
          "conventional-*",
          "dev-*",
          "global-*",
          "plugin-*",
          "plugins-*",
          "virtual-*",
          "visually-hidden",
          "workspace-*"
        ]
      }
    ],
    "shadcn/require-static-classes": "error"
  },
  "overrides": [
    {
      "files": ["packages/ui/src/components/**"],
      "rules": {
        "shadcn/no-restyle": "off",
        "shadcn/no-arbitrary-values": "off",
        "shadcn/no-inline-styles": "off",
        "shadcn/require-static-classes": "off"
      }
    }
  ],
  "ignorePatterns": [
    "node_modules/**",
    ".wrangler/**",
    ".turbo/**",
    ".vite/**",
    "**/routeTree.gen.ts",
    "dist/**",
    "out/**",
    "build/**",
    "coverage/**"
  ]
}
