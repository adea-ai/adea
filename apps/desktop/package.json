{
  "name": "@adea-ai/desktop",
  "version": "0.10.17",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "bun run client:build",
    "client:build": "vite build",
    "client:dev": "vite --host 127.0.0.1 --port 1420",
    "client:prepare": "bun ../../scripts/sync-assets.mjs && bunx turbo run build --filter=@adea-ai/desktop^...",
    "shell:client:build": "bun run client:prepare && bun run client:build",
    "shell:client:dev": "bun run client:prepare && bun run client:dev",
    "shell:dev": "bun scripts/tauri.mjs dev",
    "shell:build": "bun scripts/tauri.mjs build",
    "lint": "eslint .",
    "test": "bun test tests/unit",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@tauri-apps/cli": "^2.5.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "vite": "^8.2.2"
  },
  "dependencies": {
    "@adea-ai/api-client": "workspace:*",
    "@adea-ai/audio": "workspace:*",
    "@adea-ai/auth": "workspace:*",
    "@adea-ai/data": "workspace:*",
    "@adea-ai/state": "workspace:*",
    "@adea-ai/ui": "workspace:*",
    "@adea-ai/workspace-ui": "workspace:*",
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-updater": "^2.10.1",
    "lucide-react": "^1.33.0",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  }
}
