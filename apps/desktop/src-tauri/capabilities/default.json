{
  "$schema": "../gen/schemas/desktop-capabilities.json",
  "identifier": "default",
  "description": "Minimal default permissions for the Adea desktop shell",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "updater:default",
    "allow-desktop-auth",
    "allow-desktop-capabilities",
    "allow-desktop-preferences",
    "allow-desktop-transcription",
    "allow-desktop-updater",
    "allow-local-content"
  ]
}
