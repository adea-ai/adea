{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Adea",
  "version": "../package.json",
  "identifier": "com.adea.desktop",
  "build": {
    "beforeDevCommand": "bun run shell:client:dev",
    "beforeBuildCommand": "bun run shell:client:build",
    "devUrl": "http://127.0.0.1:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "security": {
      "csp": "default-src 'self' customprotocol: asset:; connect-src 'self' blob: ipc: http://ipc.localhost https://adea.dev ws://127.0.0.1:1420; img-src 'self' asset: data: blob: https://raw.githubusercontent.com; script-src 'self' 'wasm-unsafe-eval'; style-src 'self'",
      "freezePrototype": true
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/64x64.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["agent-hq"]
      }
    },
    "updater": {
      "dialog": false,
      "endpoints": ["https://github.com/adea-ai/adea/releases/latest/download/latest.json"],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDY1MjgzRDRBMEYwMzVCRDYKUldUV1d3TVBTajBvWlY1NHA5MXlxdFFnNStMbWZlNTFqZWI2Wi85SlJqZ0JQUHNmVWRScmVQTnIK"
    }
  }
}
