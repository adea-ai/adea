  "productName": "Agent HQ",
  "version": "0.3.0",
  "identifier": "com.agenthq.desktop",
  "build": {
    "beforeDevCommand": "PORT=3004 bun --cwd ../web dev",
    "devUrl": "http://127.0.0.1:3004"
  },
  "app": {
    "withGlobalTauri": false,
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/64x64.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
