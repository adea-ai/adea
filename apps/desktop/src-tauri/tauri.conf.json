{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Agent HQ",
  "version": "0.5.0",
  "identifier": "com.agenthq.desktop",
  "build": {
    "beforeDevCommand": "bun run shell:client:dev",
    "beforeBuildCommand": "bun run shell:client:build",
    "devUrl": "http://127.0.0.1:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "security": {
      "csp": "default-src 'self' customprotocol: asset:; connect-src 'self' ipc: http://ipc.localhost https://agent-hq-site.vercel.app ws://127.0.0.1:1420; img-src 'self' asset: data:; script-src 'self'; style-src 'self'",
      "freezePrototype": true
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/64x64.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["agent-hq"]
      }
    },
    "updater": {
      "dialog": false,
      "endpoints": [
        "https://0xplayerone.github.io/agent-hq/desktop-updates/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDY1MjgzRDRBMEYwMzVCRDYKUldUV1d3TVBTajBvWlY1NHA5MXlxdFFnNStMbWZlNTFqZWI2Wi85SlJqZ0JQUHNmVWRScmVQTnIK"
    }
  }
}
