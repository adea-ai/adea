# Local PostgreSQL only. Hosted values live in the Cloudflare Secret Store and must never be committed.
DATABASE_URL=postgresql://agent_hq_local_app:agent_hq_local_app@127.0.0.1:55432/agent_hq?sslmode=disable
DATABASE_URL_UNPOOLED=postgresql://agent_hq_local_app:agent_hq_local_app@127.0.0.1:55432/agent_hq?sslmode=disable
DATABASE_MIGRATION_URL=postgresql://agent_hq_local_migration:agent_hq_local_migration@127.0.0.1:55432/agent_hq?sslmode=disable

# Use the development branch values from `neonctl neon-auth status` for local auth testing.
NEON_AUTH_BASE_URL=https://replace-with-development-branch.neonauth.example/neondb/auth
NEON_AUTH_COOKIE_SECRET=replace-with-at-least-32-random-characters
AUTH_TRUSTED_ORIGINS=http://localhost:3000,adea://auth/callback

# Server-only Control Plane marketplace proxy. Never expose the token to the browser.
CONTROL_PLANE_ORIGIN=https://control-planecontrol-api-production.up.railway.app
CONTROL_PLANE_SERVICE_TOKEN=replace-with-scoped-control-plane-service-token
CONTROL_PLANE_SCOPE_WORKSPACE_ID=replace-with-control-plane-scope-workspace-id
# Per-request signed Control Plane credentials (ADR 0013,
# docs/control-plane-credentials.md). Leave CONTROL_PLANE_SIGNING_KEY empty to
# use the static token above (the deployment then reports `unscoped`).
CONTROL_PLANE_SIGNING_KEY=
CONTROL_PLANE_SIGNING_KEY_ID=
CONTROL_PLANE_SIGNING_ISSUER=
