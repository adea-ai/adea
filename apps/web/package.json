{
  "name": "@adea-ai/web",
  "version": "0.14.0",
  "private": true,
  "type": "module",
  "scripts": {
    "lint": "oxlint",
    "dev": "bun ../../scripts/sync-assets.mjs && sh -c 'next dev --webpack -H 0.0.0.0 -p \"${PORT:-3000}\"'",
    "build": "bun run cf-typegen && bun ../../scripts/sync-assets.mjs && next build --webpack",
    "build:worker": "opennextjs-cloudflare build",
    "build:cloudflare": "bun run --cwd ../.. build:cloudflare",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "upload": "opennextjs-cloudflare build && opennextjs-cloudflare upload",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "start": "next start -H 0.0.0.0 -p ${PORT:-3004}",
    "test": "bun test test/*.test.ts",
    "typecheck": "bun run cf-typegen && tsc --noEmit"
  },
  "dependencies": {
    "@adea-ai/api-client": "workspace:*",
    "@adea-ai/app-core": "workspace:*",
    "@adea-ai/asset-manifests": "workspace:*",
    "@adea-ai/audio": "workspace:*",
    "@adea-ai/auth": "workspace:*",
    "@adea-ai/data": "workspace:*",
    "@adea-ai/db": "workspace:*",
    "@adea-ai/spatial-protocol": "workspace:*",
    "@adea-ai/state": "workspace:*",
    "@adea-ai/types": "workspace:*",
    "@adea-ai/ui": "workspace:*",
    "@adea-ai/workspace-ui": "workspace:*",
    "@tauri-apps/api": "^2.11.1",
    "lucide-react": "^1.33.0",
    "next": "16.3.4",
    "next-themes": "^0.4.6",
    "nuqs": "^2.10.1",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "^1.20.6",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@types/three": "^0.185.0",
    "shadcn": "^4.18.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "wrangler": "^4.130.0"
  }
}
