{
  "extends": "../../../tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "jsx": "react-jsx",
    "allowJs": true,
    "checkJs": true,
    "types": ["vite/client", "bun-types"],
    "verbatimModuleSyntax": false,
    "lib": ["DOM", "DOM.Iterable", "ES2023"]
  },
  "include": [
    "./vite.config.ts",
    "../src/start-preview/**/*.ts",
    "../src/start-preview/**/*.tsx",
    "../src/start-preview/**/*.mjs"
  ]
}
