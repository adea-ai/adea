{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "types": ["bun-types", "vite/client"],
    // Workers and modern browsers both ship ES2023 (toSorted, findLast).
    "lib": ["DOM", "DOM.Iterable", "ES2023"]
  },
  "include": [
    "cloudflare-env.d.ts",
    "src/**/*.ts",
    "src/**/*.tsx",
    "vite.config.ts",
    "vite.desktop.config.ts",
    "start/**/*.ts",
    "start/**/*.tsx"
  ],
  // Bun-run tests and Playwright specs compile under their own runners, so tsc
  // covers application and build-config sources only.
  "exclude": ["node_modules", "dist", "dist-desktop", "start/routeTree.gen.ts", "e2e", "test"]
}
