{
  "$schema": "./node_modules/wrangler/config-schema.json",
  // Development-only Worker config used by the Cloudflare Vite plugin and
  // `wrangler dev`: the worker entry is the Start source entry, and bindings
  // (Hyperdrive -> local compose Postgres) resolve through the plugin's
  // workerd runtime. Deployment uses wrangler.jsonc against the built output.
  "name": "adea-web-dev",
  "main": "src/start/worker.ts",
  "compatibility_date": "2026-08-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "5faad934a0a14a29bbb4780ca2f53fa6",
      "localConnectionString": "postgresql://agent_hq_local_app:agent_hq_local_app@127.0.0.1:55432/agent_hq?sslmode=disable",
    },
  ],
  "observability": { "enabled": false },
}
