{
  "name": "adea",
  "version": "0.47.0",
  "private": true,
  "license": "Apache-2.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "build:cloudflare": "bun scripts/build-cloudflare.mjs",
    "dev": "turbo run dev --filter=@adea-ai/web --env-mode=loose",
    "fmt": "oxfmt .",
    "format:check": "oxfmt --check .",
    "format:write": "oxfmt --write .",
    "lint": "turbo run lint && oxlint --deny-warnings",
    "test": "bun run test:unit",
    "test:unit": "turbo run test && bun run test:coverage",
    "test:coverage": "bun test packages/auth/tests/unit packages/db/tests/unit packages/types/tests/execution-location.test.ts scripts/*.test.ts --coverage",
    "test:bundle:dev-view": "bun run --cwd apps/web build && bun scripts/check-dev-view-bundle.mjs",
    "test:integration": "bun scripts/test-integration.mjs",
    "typecheck": "turbo run typecheck",
    "db:health": "node scripts/database-health.mjs",
    "test:e2e": "bun scripts/e2e-setup.mjs && bunx playwright install --with-deps chromium && bunx turbo run build --filter=@adea-ai/web^... && playwright test --config=playwright.config.ts apps/web/e2e/workspace-guest.spec.ts apps/web/e2e/sidebar-resize.spec.ts apps/web/e2e/cursor-check.spec.ts apps/web/e2e/dev-view.spec.ts apps/web/e2e/appearance.spec.ts",
    "test:e2e:dev-view-terminal": "bun scripts/e2e-setup.mjs && PLAYWRIGHT_HEADLESS=1 playwright test --config=playwright.config.ts apps/web/e2e/dev-view-terminal.spec.ts",
    "test:e2e:visual": "playwright test --config=playwright.config.ts apps/web/e2e/conventional-workspace.spec.ts",
    "test:e2e:visual:chat": "playwright test --config=playwright.config.ts apps/web/e2e/chat-view-visual.spec.ts",
    "test:e2e:chat": "playwright test --config=playwright.config.ts apps/web/e2e/chat-view.spec.ts",
    "test:packaged": "bun scripts/test-dev-runtime-packaged.mjs",
    "test:packaged:owner-journey": "bun apps/desktop/shell/scripts/packaged-owner-journey.ts",
    "test:packaged:vault": "bun scripts/test-m10-33-packaged-vault.mjs",
    "test:security:dev-runtime": "bun scripts/test-dev-runtime-security.mjs",
    "test:performance:dev-runtime": "bun scripts/test-dev-runtime-performance.mjs",
    "test:performance:web": "bun scripts/measure-web-performance.mjs",
    "test:soak:dev-runtime": "bun scripts/test-dev-runtime-soak.mjs",
    "test:terminal-endurance": "bun scripts/test-dev-runtime-terminal-endurance.mjs",
    "test:perf": "bun run test:performance:dev-runtime",
    "test:security": "bun test scripts/desktop-auth-boundary.test.ts scripts/desktop-ipc-boundary.test.ts scripts/desktop-origin-boundary.test.ts",
    "test:soak": "bun run test:soak:dev-runtime",
    "test:scale:dev-runtime": "bun scripts/test-dev-runtime-scale.mjs",
    "test:scale": "bun run test:scale:dev-runtime"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@shadcn/lint": "^0.1.1",
    "@tailwindcss/postcss": "^4.3.3",
    "axe-core": "^4.13.0",
    "bun-types": "^1.4.0",
    "oxfmt": "^0.68.0",
    "oxlint": "^1.83.0",
    "release-please": "17.11.2",
    "tailwindcss": "^4.3.3",
    "turbo": "^2.10.12",
    "typescript": "^6.0.3"
  },
  "overrides": {
    "@capacitor/android": "8.5.0",
    "@capacitor/cli": "8.5.0",
    "@capacitor/core": "8.5.0",
    "@capacitor/ios": "8.5.0",
    "esbuild": "^0.25.0",
    "sharp": "0.35.4",
    "uuid": "^11.1.1"
  },
  "engines": {
    "node": "24.18.0"
  },
  "packageManager": "bun@1.4.0"
}
