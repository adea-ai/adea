{
  "name": "adea",
  "version": "0.14.0",
  "private": true,
  "license": "Apache-2.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "build:cloudflare": "bun scripts/build-cloudflare-worker.mjs",
    "dev": "turbo run dev --filter=@adea-ai/web --env-mode=loose",
    "format:check": "oxfmt --check .",
    "format:write": "oxfmt --write .",
    "lint": "turbo run lint",
    "test": "bun run test:unit",
    "test:unit": "turbo run test && bun run test:coverage",
    "test:coverage": "bun test packages/auth/tests/unit packages/db/tests/unit scripts/*.test.ts --coverage",
    "test:integration": "bun scripts/test-integration.mjs",
    "typecheck": "turbo run typecheck",
    "db:health": "node scripts/database-health.mjs",
    "test:e2e": "bun scripts/e2e-setup.mjs && bunx playwright install --with-deps chromium && bunx turbo run build --filter=@adea-ai/web^... && playwright test --config=playwright.config.ts apps/web/e2e/workspace-guest.spec.ts"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4.3.3",
    "bun-types": "^1.4.0",
    "oxfmt": "^0.66.0",
    "oxlint": "^1.81.0",
    "release-please": "17.11.2",
    "shadcn": "^4.18.0",
    "tailwindcss": "^4.3.3",
    "turbo": "^2.10.12",
    "typescript": "6.0.3"
  },
  "overrides": {
    "@capacitor/android": "8.5.0",
    "@capacitor/cli": "8.5.0",
    "@capacitor/core": "8.5.0",
    "@capacitor/ios": "8.5.0",
    "esbuild": "^0.25.0",
    "sharp": "0.35.4",
    "uuid": "^11.1.1"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "packageManager": "bun@1.4.0"
}
