{
  "name": "agent-hq",
  "private": true,
  "license": "Apache-2.0",
  "version": "0.1.0",
  "packageManager": "bun@1.4.0",
  "overrides": {
    "uuid": "^11.1.1"
  },
  "workspaces": [
    "apps/*",
    "packages/*",
    "scenes/*"
  ],
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build": "turbo run build",
    "build:desktop": "turbo run shell:build --filter=@agent-hq/desktop",
    "build:mobile": "turbo run shell:build --filter=@agent-hq/mobile",
    "dev": "turbo run dev --filter=@agent-hq/web",
    "dev:desktop": "turbo run shell:dev --filter=@agent-hq/desktop",
    "dev:mobile": "turbo run shell:dev --filter=@agent-hq/mobile",
    "format:check": "prettier --check .",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/postcss": "^4.3.3",
    "eslint": "^10.9.0",
    "eslint-config-next": "^16.3.2",
    "globals": "^17.11.0",
    "bun-types": "^1.4.0",
    "prettier": "^3.9.6",
    "shadcn": "^4.18.0",
    "tailwindcss": "^4.3.3",
    "typescript-eslint": "^8.67.0",
    "turbo": "^2.10.11",
    "typescript": "6.0.0-beta"
  }
}
