{
  "name": "agent-hq",
  "private": true,
  "license": "Apache-2.0",
  "version": "0.1.0",
  "packageManager": "bun@1.4.0",
  "overrides": {
    "uuid": "^11.1.1"
  },
  "workspaces": [
    "apps/*",
    "packages/*",
    "scenes/*"
  ],
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build": "turbo run build && bun run perf:check",
    "dev": "turbo run dev --filter=@agent-hq/web --env-mode=loose",
    "format:check": "prettier --check .",
    "lint": "turbo run lint",
    "test": "turbo run test && bun test scripts/*.test.ts",
    "typecheck": "turbo run typecheck",
    "perf:check": "bun scripts/performance-budgets.mjs --build --assets",
    "perf:check:runtime": "bun scripts/performance-budgets.mjs --runtime .artifacts/scene-performance.json",
    "assets:optimize:interior": "bun scripts/optimize-interior-assets.mjs"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "eslint": "^10.9.0",
    "eslint-config-next": "^16.3.2",
    "bun-types": "^1.4.0",
    "prettier": "^3.9.6",
    "shadcn": "^4.18.0",
    "tailwindcss": "^4.3.3",
    "turbo": "^2.10.11",
    "typescript": "6.0.0-beta"
  }
}
