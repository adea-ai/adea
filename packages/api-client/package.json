{
  "name": "@adea-ai/api-client",
  "version": "0.85.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    "./runtime-node-delivery": {
      "types": "./dist/runtime-node-delivery.d.ts",
      "development": "./src/runtime-node-delivery.ts",
      "import": "./dist/runtime-node-delivery.js"
    },
    ".": {
      "types": "./dist/index.d.ts",
      "development": "./src/index.ts",
      "import": "./dist/index.js"
    },
    "./task-submission": {
      "types": "./dist/task-submission.d.ts",
      "development": "./src/task-submission.ts",
      "import": "./dist/task-submission.js"
    }
  },
  "scripts": {
    "lint": "oxlint",
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch --preserveWatchOutput",
    "test": "bun test tests/unit",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@adea-ai/types": "workspace:*"
  }
}
