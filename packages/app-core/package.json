{
  "name": "@agent-hq/app-core",
  "version": "0.9.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "development": "./src/index.ts",
      "import": "./dist/index.js"
    },
    "./workspace-scene": {
      "types": "./dist/workspace-scene.d.ts",
      "development": "./src/workspace-scene.ts",
      "import": "./dist/workspace-scene.js"
    }
  },
  "scripts": {
    "lint": "eslint .",
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch --preserveWatchOutput",
    "test": "bun test test/*.test.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@agent-hq/types": "workspace:*"
  }
}
