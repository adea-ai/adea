{
  "name": "@adea-ai/asset-manifests",
  "version": "0.22.0",
  "description": "Shared scene and asset manifest contracts for Adea workspaces.",
  "keywords": [
    "assets",
    "manifest",
    "scene",
    "threejs",
    "workspace"
  ],
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/adea-ai/adea.git",
    "directory": "packages/asset-manifests"
  },
  "files": [
    "dist",
    "src",
    "tsconfig.json",
    "README.md"
  ],
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "development": "./src/index.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "lint": "oxlint",
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch --preserveWatchOutput",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  }
}
