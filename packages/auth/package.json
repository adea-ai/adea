{
  "name": "@adea-ai/auth",
  "version": "0.98.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "development": "./src/index.ts",
      "import": "./dist/index.js"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "development": "./src/client.ts",
      "import": "./dist/client.js"
    },
    "./desktop": {
      "types": "./dist/desktop.d.ts",
      "development": "./src/desktop.ts",
      "import": "./dist/desktop.js"
    },
    "./authorization": {
      "types": "./dist/authorization.d.ts",
      "development": "./src/authorization.ts",
      "import": "./dist/authorization.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "development": "./src/server.ts",
      "import": "./dist/server.js"
    },
    "./vite-client-bundle": {
      "types": "./dist/vite-client-bundle.d.ts",
      "development": "./src/vite-client-bundle.ts",
      "import": "./dist/vite-client-bundle.js"
    },
    "./start": {
      "types": "./dist/start.d.ts",
      "development": "./src/start.ts",
      "import": "./dist/start.js"
    }
  },
  "scripts": {
    "lint": "oxlint",
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch --preserveWatchOutput",
    "typecheck": "bun check -p tsconfig.json",
    "test": "bun test tests/unit",
    "test:integration": "bun test tests/integration",
    "schema-init": "bun src/schema-init-cli.ts"
  },
  "dependencies": {
    "@adea-ai/types": "workspace:*",
    "@neondatabase/auth": "0.5.0-beta",
    "better-auth": "1.6.23",
    "pg": "8.23.1",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@types/pg": "8.23.1"
  }
}
