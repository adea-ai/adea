{
  "name": "@adea-ai/data",
  "version": "0.84.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "solid": "./src/index.ts",
      "development": "./src/index.ts",
      "import": "./dist/index.js"
    },
    "./provider": {
      "types": "./dist/provider.d.ts",
      "solid": "./src/provider.tsx",
      "development": "./src/provider.tsx",
      "import": "./dist/provider.js"
    },
    "./events": {
      "types": "./dist/events.d.ts",
      "solid": "./src/events.ts",
      "development": "./src/events.ts",
      "import": "./dist/events.js"
    },
    "./dev-runtime": {
      "types": "./dist/dev-runtime.d.ts",
      "solid": "./src/dev-runtime.ts",
      "development": "./src/dev-runtime.ts",
      "import": "./dist/dev-runtime.js"
    },
    "./control-plane": {
      "types": "./dist/control-plane.d.ts",
      "solid": "./src/control-plane.ts",
      "development": "./src/control-plane.ts",
      "import": "./dist/control-plane.js"
    }
  },
  "scripts": {
    "lint": "oxlint",
    "build": "vite build && tsc -p tsconfig.json --emitDeclarationOnly",
    "dev": "vite build --watch",
    "test": "bun test tests/unit",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@adea-ai/api-client": "workspace:*",
    "@adea-ai/state": "workspace:*",
    "@adea-ai/types": "workspace:*",
    "@tanstack/solid-query": "^5.104.1",
    "solid-js": "^1.9.15"
  },
  "devDependencies": {
    "vite": "^8.3.2",
    "vite-plugin-solid": "^2.11.14"
  }
}
