{
  "name": "@adea-ai/dev-view",
  "version": "0.32.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "solid": "./src/index.ts",
      "development": "./src/index.ts",
      "import": "./dist/index.js"
    },
    "./platform": {
      "types": "./dist/platform.d.ts",
      "solid": "./src/platform.ts",
      "development": "./src/platform.ts",
      "import": "./dist/platform.js"
    },
    "./appearance": {
      "types": "./dist/appearance/index.d.ts",
      "solid": "./src/appearance/index.ts",
      "development": "./src/appearance/index.ts",
      "import": "./dist/appearance/index.js"
    },
    "./browser": {
      "types": "./dist/browser/index.d.ts",
      "solid": "./src/browser/index.ts",
      "development": "./src/browser/index.ts",
      "import": "./dist/browser/index.js"
    },
    "./devices": {
      "types": "./dist/devices/index.d.ts",
      "solid": "./src/devices/index.ts",
      "development": "./src/devices/index.ts",
      "import": "./dist/devices/index.js"
    }
  },
  "scripts": {
    "build": "vite build && tsc -p tsconfig.json --emitDeclarationOnly",
    "dev": "vite build --watch",
    "lint": "oxlint",
    "test": "bun test --conditions=browser tests",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@adea-ai/state": "workspace:*",
    "@adea-ai/types": "workspace:*",
    "@adea-ai/ui": "workspace:*",
    "lucide-solid": "^1.45.0",
    "solid-js": "^1.9.15"
  },
  "devDependencies": {
    "vite": "^8.0.14",
    "vite-plugin-solid": "^2.11.14"
  }
}
