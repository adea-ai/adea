      "import": "./dist/desktop-permissions.js"
    },
    "./dev-runtime-control": {
      "types": "./dist/dev-runtime-control.d.ts",
      "development": "./src/dev-runtime-control.ts",
      "import": "./dist/dev-runtime-control.js"
    },
    "./dev-runtime-errors": {
      "types": "./dist/dev-runtime-errors.d.ts",
      "development": "./src/dev-runtime-errors.ts",
      "import": "./dist/dev-runtime-errors.js"
    }
  },
  "scripts": {
    "lint": "oxlint",
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch --preserveWatchOutput",
    "test": "bun test tests",
    "typecheck": "tsc -p tsconfig.json --noEmit"
