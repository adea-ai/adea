{
  "name": "@adea-ai/types",
  "version": "0.58.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "development": "./src/index.ts",
      "import": "./dist/index.js"
    },
    "./dev-runtime": {
      "types": "./dist/dev-runtime.d.ts",
      "development": "./src/dev-runtime.ts",
      "import": "./dist/dev-runtime.js"
    },
    "./desktop-permissions": {
      "types": "./dist/desktop-permissions.d.ts",
      "development": "./src/desktop-permissions.ts",
      "import": "./dist/desktop-permissions.js"
    }
  },
  "scripts": {
    "lint": "oxlint",
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch --preserveWatchOutput",
    "test": "bun test tests",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  }
}
