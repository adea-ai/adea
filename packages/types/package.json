{
  "name": "@adea-ai/types",
  "version": "0.64.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "development": "./src/index.ts",
      "import": "./dist/index.js"
    },
    "./dev-runtime": {
      "types": "./dist/dev-runtime.d.ts",
      "development": "./src/dev-runtime.ts",
      "import": "./dist/dev-runtime.js"
    },
    "./dev-runtime-video": {
      "types": "./dist/dev-runtime-video.d.ts",
      "development": "./src/dev-runtime-video.ts",
      "import": "./dist/dev-runtime-video.js"
    },
    "./dev-runtime-metadata": {
      "types": "./dist/dev-runtime-metadata.d.ts",
      "development": "./src/dev-runtime-metadata.ts",
      "import": "./dist/dev-runtime-metadata.js"
    },
    "./dev-runtime-operation-metadata": {
      "types": "./dist/dev-runtime-operation-metadata/index.d.ts",
      "development": "./src/dev-runtime-operation-metadata/index.ts",
      "import": "./dist/dev-runtime-operation-metadata/index.js"
    },
    "./dev-runtime-wire": {
      "types": "./dist/dev-runtime-wire.d.ts",
      "development": "./src/dev-runtime-wire.ts",
      "import": "./dist/dev-runtime-wire.js"
    },
    "./dev-runtime-registry-dto": {
      "types": "./dist/dev-runtime-registry-dto.d.ts",
