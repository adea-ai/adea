{
  "name": "@adea-ai/ui",
  "version": "0.18.5",
  "description": "Shared UI kit for Adea: Base UI-backed shadcn primitives, workspace shells, and theme styles.",
  "keywords": [
    "base-ui",
    "components",
    "react",
    "shadcn",
    "tailwind",
    "workspace"
  ],
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/adea-ai/adea.git",
    "directory": "packages/ui"
  },
  "files": [
    "dist",
    "src",
    "components.json",
    "tsconfig.json",
    "README.md"
  ],
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "imports": {
    "#components/*": "./src/components/*.tsx",
    "#lib/*": "./src/lib/*.ts"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "development": "./src/index.tsx",
      "import": "./dist/index.js"
    },
    "./components/*": {
      "types": "./dist/components/*.d.ts",
      "development": "./src/components/*",
      "import": "./dist/components/*.js"
    },
    "./lib/*": {
      "types": "./dist/lib/*.d.ts",
      "development": "./src/lib/*",
      "import": "./dist/lib/*.js"
    },
    "./globals.css": "./src/styles/globals.css",
    "./auth-shell.css": "./src/styles/auth-shell.css",
    "./conventional-workspace.css": "./src/styles/conventional-workspace.css",
    "./theme.css": "./src/styles/theme.css",
    "./workspace-shell.css": "./src/styles/workspace-shell.css"
  },
  "scripts": {
    "lint": "oxlint",
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch --preserveWatchOutput",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.33.0",
    "next-themes": "^0.4.6",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4"
  }
}
