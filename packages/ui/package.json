{
  "name": "@adea-ai/app-ui",
  "version": "0.99.0",
  "private": true,
  "description": "Adea application preferences, host adapters, and product styles over the shared UI system.",
  "keywords": [
    "components",
    "corvu",
    "kobalte",
    "solid",
    "tailwind",
    "workspace"
  ],
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/adea-ai/adea.git",
    "directory": "packages/ui"
  },
  "files": [
    "dist",
    "src",
    "tsconfig.json",
    "README.md"
  ],
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "imports": {
    "#components/*": "./src/components/*.tsx",
    "#lib/*": "./src/lib/*.ts"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "solid": "./src/index.tsx",
      "development": "./src/index.tsx",
      "import": "./dist/index.js"
    },
    "./components/*": {
      "types": "./dist/components/*.d.ts",
      "solid": "./src/components/*",
      "development": "./src/components/*",
      "import": "./dist/components/*.js"
    },
    "./lib/*": {
      "types": "./dist/lib/*.d.ts",
      "solid": "./src/lib/*",
      "development": "./src/lib/*",
      "import": "./dist/lib/*.js"
    },
    "./globals.css": "./src/styles/globals.css",
    "./auth-shell.css": "./src/styles/auth-shell.css",
    "./conventional-workspace.css": "./src/styles/conventional-workspace.css",
    "./dev-view.css": "./src/styles/dev-view.css",
    "./theme.css": "./src/styles/theme.css",
    "./workspace-shell.css": "./src/styles/workspace-shell.css",
    "./workspace-nav.css": "./src/styles/workspace-nav.css",
    "./base.css": "./src/styles/base.css"
  },
  "scripts": {
    "lint": "oxlint",
    "build": "vite build && tsc -p tsconfig.json --emitDeclarationOnly",
    "dev": "vite build --watch",
    "test": "bun test --conditions=browser --preload ../../scripts/test-solid-transform.ts tests",
    "typecheck": "bun check -p tsconfig.json"
  },
  "dependencies": {
    "@adea-ai/ui": "0.143.0",
    "lucide-solid": "^1.51.0",
    "solid-js": "^1.9.15"
  },
  "devDependencies": {
    "vite": "^8.3.3",
    "vite-plugin-solid": "^2.11.14"
  }
}
