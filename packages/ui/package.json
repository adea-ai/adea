{
  "name": "@adea-ai/app-ui",
  "version": "0.61.4",
  "description": "Shared UI kit for Adea: Kobalte/corvu-backed Solid primitives, workspace shells, and theme styles.",
  "keywords": [
    "components",
    "corvu",
    "kobalte",
    "solid",
    "tailwind",
    "workspace"
  ],
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/adea-ai/adea.git",
    "directory": "packages/ui"
  },
  "files": [
    "dist",
    "src",
    "tsconfig.json",
    "README.md"
  ],
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "imports": {
    "#components/*": "./src/components/*.tsx",
    "#lib/*": "./src/lib/*.ts"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "solid": "./src/index.tsx",
      "development": "./src/index.tsx",
      "import": "./dist/index.js"
    },
    "./components/*": {
      "types": "./dist/components/*.d.ts",
      "solid": "./src/components/*",
      "development": "./src/components/*",
      "import": "./dist/components/*.js"
    },
    "./lib/*": {
      "types": "./dist/lib/*.d.ts",
      "solid": "./src/lib/*",
      "development": "./src/lib/*",
      "import": "./dist/lib/*.js"
    },
    "./globals.css": "./src/styles/globals.css",
    "./auth-shell.css": "./src/styles/auth-shell.css",
    "./conventional-workspace.css": "./src/styles/conventional-workspace.css",
    "./dev-view.css": "./src/styles/dev-view.css",
    "./theme.css": "./src/styles/theme.css",
    "./workspace-shell.css": "./src/styles/workspace-shell.css",
    "./base.css": "./src/styles/base.css"
  },
  "scripts": {
    "lint": "oxlint",
    "build": "vite build && tsc -p tsconfig.json --emitDeclarationOnly",
    "dev": "vite build --watch",
    "themes:check": "bun scripts/generate-canonical-theme-data.ts --check",
    "themes:generate": "bun scripts/generate-canonical-theme-data.ts",
    "test": "bun run themes:check && bun test tests",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@adea-ai/ui": "0.63.2",
    "@corvu/drawer": "^0.2.4",
    "@kobalte/core": "^0.13.14",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-solid": "^1.45.0",
    "solid-js": "^1.9.15",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@adea-ai/themes": "0.5.0",
    "vite": "^8.0.14",
    "vite-plugin-solid": "^2.11.14"
  },
  "private": true
}
