{
  "name": "@agent-hq/hq-scenes",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./home": {
      "types": "./dist/home.d.ts",
      "import": "./dist/home.js"
    },
    "./work": {
      "types": "./dist/work.d.ts",
      "import": "./dist/work.js"
    }
  },
  "scripts": {
    "lint": "eslint .",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@agent-hq/asset-manifests": "workspace:*",
    "@agent-hq/interior": "workspace:*"
  }
}
