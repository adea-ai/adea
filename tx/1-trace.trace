dcfff;\n  --editor-search-match: #e0af68;\n  --chart-1: #7aa2f7;\n  --chart-2: #bb9af7;\n  --chart-3: #7dcfff;\n  --chart-4: #9ece6a;\n  --chart-5: #e0af68;\n  --chart-6: #f7768e;\n}\n[data-theme='vesper'] {\n  --background: #101010;\n  --foreground: #ffffff;\n  --card: #181818;\n  --card-foreground: #ffffff;\n  --popover: #1f1f1f;\n  --popover-foreground: #ffffff;\n  --primary: #aca1cf;\n  --primary-foreground: #101010;\n  --secondary: #181818;\n  --secondary-foreground: #ffffff;\n  --muted: #181818;\n  --muted-foreground: #a9a9a9;\n  --accent: #272727;\n  --accent-foreground: #ffffff;\n  --destructive: #f5a191;\n  --destructive-action: #f5a191;\n  --destructive-action-foreground: #101010;\n  --success: #90b99f;\n  --border: #333333;\n  --input: #333333;\n  --ring: #aca1cf;\n  --primary-hover: #bcb1df;\n  --primary-subtle: var(--primary);\n  @supports (color: color-mix(in lab, red, red)) {\n    --primary-subtle: color-mix(in oklch, var(--primary) 16%, transparent);\n  }\n  --destructive-foreground: #101010;\n  --destructive-subtle: #2a211f;\n  --success-foreground: #101010;\n  --success-subtle: #1f2421;\n  --warning: #e6b99d;\n  --warning-foreground: #101010;\n  --warning-subtle: #292421;\n  --info: #ea83a5;\n  --info-foreground: #101010;\n  --info-subtle: #2a1e21;\n  --sidebar: #181818;\n  --sidebar-foreground: #ffffff;\n  --sidebar-accent: #272727;\n  --sidebar-border: #333333;\n  --sidebar-primary: #aca1cf;\n  --sidebar-primary-foreground: #101010;\n  --sidebar-ring: #aca1cf;\n  --sidebar-muted-foreground: #a9a9a9;\n  --surface-sunken: #181818;\n  --surface-hover: #272727;\n  --surface-active: #333333;\n  --chrome: #101010;\n  --terminal-background: #101010;\n  --terminal-foreground: #ffffff;\n  --terminal-cursor: #ffffff;\n  --terminal-selection: #988049;\n  --terminal-ansi-black: #4f442c;\n  --terminal-ansi-red: #f5a191;\n  --terminal-ansi-green: #90b99f;\n  --terminal-ansi-yellow: #e6b99d;\n  --terminal-ansi-blue: #aca1cf;\n  --terminal-ansi-magenta: #e29eca;\n  --terminal-ansi-cyan: #ea83a5;\n  --terminal-ansi-white: #bcbcbc;\n  --terminal-ansi-bright-black: #7e7e7e;\n  --terminal-ansi-bright-red: #ff8080;\n  --terminal-ansi-bright-green: #99ffe4;\n  --terminal-ansi-bright-yellow: #ffc799;\n  --terminal-ansi-bright-blue: #b9aeda;\n  --terminal-ansi-bright-magenta: #ecaad6;\n  --terminal-ansi-bright-cyan: #f591b2;\n  --terminal-ansi-bright-white: #ffffff;\n  --editor-keyword: #e29eca;\n  --editor-string: #90b99f;\n  --editor-number: #e6b99d;\n  --editor-comment: #7e7e7e;\n  --editor-function: #aca1cf;\n  --editor-variable: #bcbcbc;\n  --editor-type: #ea83a5;\n  --editor-tag: #f5a191;\n  --editor-attribute: #e6b99d;\n  --editor-operator: #bcbcbc;\n  --editor-heading: #e29eca;\n  --editor-link: #aca1cf;\n  --editor-diff-add: #90b99f;\n  --editor-diff-delete: #f5a191;\n  --editor-diff-hunk: #ea83a5;\n  --editor-search-match: #e6b99d;\n  --chart-1: #aca1cf;\n  --chart-2: #e29eca;\n  --chart-3: #ea83a5;\n  --chart-4: #90b99f;\n  --chart-5: #e6b99d;\n  --chart-6: #f5a191;\n}\n.auth-shell {\n  --auth-background: var(--background);\n  --auth-surface: var(--card);\n  --auth-surface-strong: var(--secondary);\n  --auth-border: var(--border);\n  --auth-border-subtle: var(--input);\n  --auth-foreground: var(--foreground);\n  --auth-muted: var(--muted-foreground);\n  --auth-muted-strong: var(--muted-foreground);\n  --auth-accent: var(--primary);\n  --auth-accent-foreground: var(--primary-foreground);\n  --auth-grid-line: var(--border);\n  @supports (color: color-mix(in lab, red, red)) {\n    --auth-grid-line: color-mix(in oklab, var(--border) 12%, transparent);\n  }\n  --auth-panel-shadow: var(--shadow-xl);\n  display: grid;\n  min-height: 100svh;\n  place-items: center;\n  padding: 1.5rem;\n  background: linear-gradient(90deg, var(--auth-grid-line) 1px, transparent 1px) 0 0 / 4rem 4rem,\n    var(--auth-background);\n  color: var(--auth-foreground);\n}\n.auth-panel {\n  width: min(100%, 40rem);\n  padding: clamp(1.5rem, 5vw, 3.5rem);\n  border: 1px solid var(--auth-border);\n  border-radius: 0.75rem;\n  background: var(--auth-surface);\n  box-shadow: var(--auth-panel-shadow);\n}\n.auth-eyebrow {\n  margin: 0 0 0.75rem;\n  color: var(--auth-accent);\n  font-size: 0.75rem;\n  font-weight: 800;\n  letter-spacing: 0.14em;\n  text-transform: uppercase;\n}\n.auth-title {\n  max-width: 13ch;\n  margin: 0;\n  font-size: clamp(2rem, 7vw, 3.5rem);\n  line-height: 1;\n  letter-spacing: -0.04em;\n}\n.auth-introduction {\n  max-width: 52ch;\n  margin: 1.5rem 0;\n  color: var(--auth-muted);\n  line-height: 1.6;\n}\n.auth-status {\n  display: flex;\n  gap: 0.75rem;\n  align-items: flex-start;\n  min-height: 4.5rem;\n  margin: 0 0 1.25rem;\n  padding: 1rem;\n  border-left: 2px solid var(--auth-border-subtle);\n  background: var(--auth-surface-strong);\n}\n.auth-status p {\n  margin: 0;\n  color: var(--auth-foreground);\n  line-height: 1.5;\n}\n.auth-status__mark {\n  flex: 0 0 auto;\n  width: 0.65rem;\n  height: 0.65rem;\n  margin-top: 0.4rem;\n  border: 2px solid var(--auth-muted-strong);\n  border-radius: 50%;\n}\n.auth-status__mark--active {\n  border-color: var(--auth-accent);\n  background: var(--auth-accent);\n}\n.auth-status__mark--ready {\n  border-color: var(--success);\n  background: var(--success);\n}\n.auth-status__mark--warning {\n  border-color: var(--warning);\n  background: var(--warning);\n}\n.auth-status__mark--error {\n  border-color: var(--destructive);\n  background: var(--destructive);\n}\n.auth-actions {\n  display: flex;\n  flex-wrap: wrap;\n  gap: 0.75rem;\n}\n.auth-actions button {\n  min-height: 2.75rem;\n  padding: 0 1rem;\n  border: 0;\n  border-radius: 0.45rem;\n  color: var(--auth-accent-foreground);\n  background: var(--auth-accent);\n  font: inherit;\n  font-weight: 650;\n  cursor: pointer;\n}\n.auth-actions button:disabled {\n  cursor: wait;\n  opacity: 0.65;\n}\n.auth-actions button:focus-visible {\n  outline: 3px solid var(--auth-foreground);\n  outline-offset: 2px;\n}\n.auth-note {\n  max-width: 56ch;\n  margin: 1.25rem 0 0;\n  color: var(--auth-muted-strong);\n  font-size: 0.8125rem;\n  line-height: 1.5;\n}\n@media (max-width: 30rem) {\n  .auth-shell {\n    padding: 0;\n  }\n  .auth-panel {\n    min-height: 100svh;\n    border: 0;\n    border-radius: 0;\n  }\n}\n.workspace-account-drawer__content {\n  width: min(24rem, 90vw);\n}\n.workspace-brand__mark {\n  display: inline-flex;\n  flex: 0 0 auto;\n  align-items: center;\n  justify-content: center;\n  width: 2.1rem;\n  height: 2.1rem;\n  border-radius: 0.55rem;\n  color: var(--primary-foreground);\n  background: var(--primary);\n  font-family: 'SFMono-Regular', Consolas, 'Liberation Mono', monospace;\n  font-size: 0.75rem;\n  font-weight: 800;\n  letter-spacing: -0.08em;\n}\n.virtual-view-engine {\n  position: absolute;\n  inset: 0;\n}\n.workspace-scene-viewport:has([data-room-designer-active='true'])\n  .workspace-ui\n  :is(.conventional-mobile-menu, .workspace-scene-caption) {\n  display: none;\n}\n.workspace-runtime-chat {\n  flex: 1;\n  min-width: 0;\n  min-height: 0;\n  overflow: hidden;\n}\n.workspace-frame {\n  --workspace-rail-width: var(--rail-width);\n  --workspace-topbar-height: 3rem;\n  position: fixed;\n  inset: 0;\n  display: grid;\n  grid-template-columns: var(--workspace-rail-width) minmax(0, 1fr);\n  grid-template-rows: var(--workspace-topbar-height) minmax(0, 1fr);\n  min-width: 0;\n  height: 100svh;\n  overflow: clip;\n  background: var(--background);\n  color: var(--foreground);\n}\n.workspace-frame__surface {\n  position: absolute;\n  inset-block: var(--workspace-topbar-height) 0;\n  inset-inline: var(--workspace-rail-width) 0;\n  min-width: 0;\n  min-height: 0;\n  overflow: hidden;\n}\n.workspace-switching {\n  position: absolute;\n  inset-block-start: 1rem;\n  inset-inline-start: 50%;\n  translate: -50% 0;\n  z-index: var(--z-menu);\n  margin: 0;\n  padding: 0.4rem 0.8rem;\n  border: 1px solid var(--border);\n  border-radius: 999px;\n  background: var(--card);\n  color: var(--muted-foreground);\n  font-size: 0.72rem;\n  font-weight: 600;\n  letter-spacing: 0.04em;\n  pointer-events: none;\n}\n.global-rail {\n  position: relative;\n  z-index: var(--z-sticky);\n  min-width: 0;\n  padding-block: env(safe-area-inset-top) env(safe-area-inset-bottom);\n}\n.global-rail__workspace-menu {\n  width: 15rem;\n}\n.global-rail__workspace-name {\n  min-width: 0;\n  overflow: hidden;\n  text-overflow: ellipsis;\n  white-space: nowrap;\n}\n.global-rail__intent {\n  display: flex;\n  min-width: 0;\n}\n.conventional-workspace,\n.conventional-dialog {\n  --cw-bg: var(--background);\n  --cw-surface: var(--card);\n  --cw-surface-muted: var(--muted);\n  --cw-sidebar: var(--card);\n  --cw-sidebar-hover: var(--muted);\n  --cw-main: var(--background);\n  --cw-text: var(--foreground);\n  --cw-muted: var(--muted-foreground);\n  --cw-border: var(--border);\n  --cw-accent: var(--primary);\n  --cw-accent-strong: var(--primary);\n  --cw-accent-soft: var(--secondary);\n  --cw-accent-contrast: var(--primary-foreground);\n  --cw-danger: var(--destructive);\n  --cw-focus: var(--ring);\n  --cw-notice: var(--info);\n  --cw-priority-high-tint: var(--warning-subtle);\n  --cw-priority-high: var(--warning);\n  --cw-scrim: var(--scrim);\n  @supports (color: color-mix(in lab, red, red)) {\n    --cw-scrim: color-mix(in oklab, var(--scrim) 58%, transparent);\n  }\n}\n.conventional-workspace {\n  position: relative;\n  display: grid;\n  grid-template: minmax(0, 1fr) / var(--conventional-sidebar-width, 17rem) minmax(0, 1fr);\n  min-width: 0;\n  width: 100%;\n  height: 100svh;\n  overflow: clip;\n  background: var(--cw-bg);\n  color: var(--cw-text);\n  font-family: Inter, ui-sans-serif, system-ui, sans-serif;\n}\n.conventional-workspace *,\n.conventional-workspace *::before,\n.conventional-workspace *::after {\n  box-sizing: border-box;\n}\n.conventional-workspace button,\n.conventional-workspace input,\n.conventional-workspace select,\n.conventional-workspace textarea {\n  font: inherit;\n}\n.conventional-workspace button:not([data-slot]) {\n  color: inherit;\n}\n.conventional-workspace button:not(:disabled),\n.conventional-workspace select:not(:disabled) {\n  cursor: pointer;\n}\n.conventional-workspace button:disabled {\n  cursor: not-allowed;\n  opacity: 0.55;\n}\n.conventional-workspace :focus-visible {\n  outline: 3px solid var(--cw-focus);\n  outline-offset: 2px;\n}\n.conventional-workspace svg {\n  width: 1.1rem;\n  height: 1.1rem;\n  flex: none;\n}\n.conventional-workspace h1,\n.conventional-workspace h2,\n.conventional-workspace p {\n  margin: 0;\n}\n.conventional-skip-link {\n  position: fixed;\n  z-index: 100;\n  top: 0.5rem;\n  left: 0.5rem;\n  padding: 0.7rem 1rem;\n  transform: translateY(-160%);\n  border-radius: 0.4rem;\n  background: var(--cw-surface);\n  color: var(--cw-text);\n}\n.conventional-skip-link:focus {\n  transform: none;\n}\n.conventional-sidebar {\n  --sidebar-width: var(--conventional-sidebar-width, 17rem);\n  position: relative;\n  grid-row: 1;\n  min-width: 0;\n  overflow: hidden;\n}\n.conventional-sidebar__resize {\n  cursor: pointer;\n}\n.conventional-sidebar__close {\n  display: none;\n}\n.conventional-sidebar__quick-actions button {\n  width: 100%;\n}\n.conventional-sidebar__quick-actions kbd {\n  margin-left: auto;\n}\n.conventional-sidebar__content {\n  scrollbar-gutter: stable;\n}\n.conventional-sidebar__quick-actions {\n  display: flex;\n  flex-direction: column;\n  gap: 0.125rem;\n}\n.conventional-sidebar__nav-row {\n  display: flex;\n  align-items: center;\n  gap: 0.125rem;\n  min-width: 0;\n}\n.conventional-sidebar__room {\n  display: flex;\n  min-width: 0;\n  flex-direction: column;\n  gap: 0.125rem;\n}\n.conventional-sidebar__nav-item {\n  min-width: 0;\n  flex: 1;\n}\n.conventional-unread-badge {\n  min-width: 1.35rem;\n  margin-left: auto;\n  padding: 0.1rem 0.35rem;\n  border-radius: 999px;\n  background: var(--cw-accent);\n  color: var(--cw-accent-contrast);\n  font-size: 0.68rem;\n  font-weight: 800;\n  line-height: 1.1;\n  text-align: center;\n}\n.conventional-sidebar__nav-actions {\n  display: flex;\n  flex-shrink: 0;\n  align-items: center;\n  gap: 0.125rem;\n  opacity: 0;\n}\n.conventional-sidebar__nav-row:hover .conventional-sidebar__nav-actions,\n.conventional-sidebar__nav-row:focus-within .conventional-sidebar__nav-actions {\n  opacity: 1;\n}\n.conventional-sidebar__nav-nested {\n  display: flex;\n  min-width: 0;\n  flex-direction: column;\n  gap: 0.125rem;\n}\n.conventional-sidebar-error {\n  margin: 0 0.55rem 0.5rem;\n  padding: 0.5rem 0.6rem;\n  border-radius: 0.4rem;\n  background: var(--cw-danger);\n  @supports (color: color-mix(in lab, red, red)) {\n    background: color-mix(in srgb, var(--cw-danger) 10%, transparent);\n  }\n  color: var(--cw-danger);\n  font-size: 0.78rem;\n  line-height: 1.4;\n}\n.conventional-sidebar-empty {\n  padding-inline: 0.75rem;\n  color: var(--muted-foreground);\n  font-size: 0.875rem;\n  line-height: 1.45;\n}\n.conventional-sidebar__read-actions {\n  width: 100%;\n}\n.conventional-sidebar-scrim {\n  display: none;\n}\n.conventional-mobile-menu {\n  position: fixed;\n  z-index: 12;\n  top: 0.65rem;\n  left: 4.65rem;\n  display: grid;\n  width: 2.75rem;\n  height: 2.75rem;\n  place-items: center;\n  border: 1px solid var(--cw-border, var(--border));\n  border-radius: 0.4rem;\n  background: var(--cw-surface, var(--card));\n  color: var(--cw-text, var(--foreground));\n  pointer-events: auto;\n}\n.conventional-workspace:has(> .conventional-sidebar--open) .conventional-mobile-menu {\n  display: none;\n}\n.conventional-main {\n  grid-column: 2;\n  display: flex;\n  flex-direction: column;\n  min-width: 0;\n  min-height: 0;\n  overflow: hidden;\n  background: var(--cw-main);\n}\n.conventional-main > :not(.conventional-session-notice) {\n  flex: 1;\n  min-width: 0;\n  min-height: 0;\n}\n.conventional-session-notice {\n  display: grid;\n  grid-template-columns: auto minmax(0, 1fr) auto;\n  align-items: start;\n  gap: 0.65rem;\n  flex: none;\n  padding: 0.65rem 1rem;\n  border-bottom: 1px solid var(--cw-notice);\n  @supports (color: color-mix(in lab, red, red)) {\n    border-bottom: 1px solid color-mix(in srgb, var(--cw-notice) 45%, transparent);\n  }\n  background: var(--cw-notice);\n  @supports (color: color-mix(in lab, red, red)) {\n    background: color-mix(in srgb, var(--cw-notice) 12%, var(--cw-main));\n  }\n  color: var(--cw-text);\n}\n.conventional-session-notice > svg {\n  width: 1.1rem;\n  height: 1.1rem;\n  margin-top: 0.15rem;\n  color: var(--cw-notice);\n  flex: none;\n}\n.conventional-session-notice h2 {\n  font-size: 0.85rem;\n  font-weight: 700;\n}\n.conventional-session-notice p {\n  color: var(--cw-muted);\n  font-size: 0.8rem;\n  line-height: 1.45;\n}\n.conventional-session-notice button {\n  display: grid;\n  width: 2rem;\n  height: 2rem;\n  place-items: center;\n  border: 0;\n  border-radius: 0.35rem;\n  background: transparent;\n  color: var(--cw-muted);\n  cursor: pointer;\n}\n.conventional-session-notice button:hover {\n  background: var(--cw-notice);\n  @supports (color: color-mix(in lab, red, red)) {\n    background: color-mix(in srgb, var(--cw-notice) 18%, transparent);\n  }\n  color: var(--cw-text);\n}\n.conventional-session-notice button svg {\n  width: 1rem;\n  height: 1rem;\n}\n.conventional-workspace--loading {\n  grid-template: 1fr / 1fr;\n  place-items: center;\n}\n.conventional-conversation {\n  position: relative;\n  display: grid;\n  grid-template: auto minmax(0, 1fr) auto / minmax(0, 1fr);\n  height: 100%;\n}\n.conventional-conversation--thread-open {\n  grid-template-columns: minmax(24rem, 1fr) minmax(20rem, 26rem);\n}\n.conventional-conversation__header {\n  grid-column: 1;\n  display: grid;\n  gap: 0.35rem;\n  padding: 0.65rem 1.2rem 0.55rem;\n  border-bottom: 1px solid var(--cw-border);\n  background: var(--cw-surface);\n}\n.conventional-conversation__header-top {\n  display: flex;\n  min-height: 4.4rem;\n  align-items: center;\n  gap: 0.75rem;\n}\n.conventional-conversation__identity {\n  min-width: 0;\n  flex: 1;\n}\n.conventional-conversation__identity > span,\n.conventional-surface-header span {\n  color: var(--cw-muted);\n  font-size: 0.72rem;\n  font-weight: 700;\n  letter-spacing: 0.06em;\n  text-transform: uppercase;\n}\n.conventional-conversation__identity h1 {\n  overflow: hidden;\n  font-size: 1.15rem;\n  font-weight: 750;\n  letter-spacing: -0.02em;\n  text-overflow: ellipsis;\n  white-space: nowrap;\n}\n.conventional-conversation__header button {\n  display: grid;\n  width: 2.75rem;\n  height: 2.75rem;\n  place-items: center;\n  border: 0;\n  border-radius: 0.4rem;\n  background: transparent;\n}\n.conventional-conversation__header button:hover {\n  background: var(--cw-surface-muted);\n}\n.conventional-conversation__actions {\n  display: flex;\n  align-items: center;\n  justify-content: flex-end;\n  gap: 0.45rem;\n}\n.conventional-conversation__people {\n  min-width: 0;\n  overflow: hidden;\n  padding-top: 0.15rem;\n}\n.conventional-conversation__people ul {\n  display: flex;\n  justify-content: center;\n  gap: 0.6rem;\n  margin: 0;\n  padding: 0.1rem 0 0.25rem;\n  list-style: none;\n}\n.conventional-conversation__people li {\n  position: relative;\n  display: grid;\n  width: 2.25rem;\n  height: 2.25rem;\n  place-items: center;\n  flex: 0 0 auto;\n}\n.conventional-conversation__person-avatar {\n  display: grid;\n  width: 1.95rem;\n  height: 1.95rem;\n  place-items: center;\n  overflow: hidden;\n  border: 2px solid var(--cw-surface);\n  border-radius: 999px;\n  background: var(--cw-accent-soft);\n  color: var(--cw-accent-strong);\n  font-size: 0.61rem;\n  font-weight: 800;\n  letter-spacing: 0.02em;\n}\n.conventional-conversation__person-avatar img,\n.conventional-conversation__person-avatar svg {\n  width: 100%;\n  height: 100%;\n}\n.conventional-conversation__person-avatar img {\n  object-fit: cover;\n}\n.conventional-conversation__person-avatar svg {\n  width: 1rem;\n  height: 1rem;\n}\n.conventional-conversation__person-avatar--user {\n  background: var(--cw-surface-muted);\n  color: var(--cw-muted);\n}\n.conventional-conversation__person--active .conventional-conversation__person-avatar {\n  box-shadow: 0 0 0 2px var(--cw-surface),\n    0 0 0 3px var(--cw-accent-strong);\n}\n.conventional-conversation__person-presence {\n  position: absolute;\n  right: 0.12rem;\n  bottom: 0.08rem;\n  width: 0.58rem;\n  height: 0.58rem;\n  border: 2px solid var(--cw-surface);\n  border-radius: 999px;\n  background: var(--cw-accent);\n}\n.conventional-transcript {\n  grid-column: 1;\n  min-height: 0;\n  min-width: 0;\n}\n.conventional-transcript > div:first-child {\n  overflow-y: auto;\n  padding: 1.35rem clamp(0.8rem, 3vw, 2.5rem) 1.1rem;\n  scrollbar-gutter: stable;\n}\n.conventional-private-content {\n  display: flex;\n  align-items: center;\n  gap: 0.6rem;\n  margin-top: 0.55rem;\n  padding: 0.6rem 0.7rem;\n  border: 1px solid var(--cw-border);\n  border-radius: 0.65rem;\n  background: var(--cw-bg);\n}\n.conventional-private-content > div {\n  display: grid;\n  min-width: 0;\n  gap: 0.12rem;\n}\n.conventional-private-content span {\n  color: var(--cw-muted);\n  font-size: 0.7rem;\n}\n.conventional-composer {\n  position: relative;\n  grid-column: 1;\n  margin: 0 clamp(0.8rem, 3vw, 2.5rem) 1.15rem;\n}\n.conventional-composer__context {\n  padding: 0.45rem 0.9rem;\n  border-bottom: 1px solid var(--cw-border);\n  color: var(--cw-muted);\n  font-size: 0.72rem;\n}\n.conventional-composer textarea {\n  display: block;\n  width: 100%;\n  min-height: 4.1rem;\n  max-height: 12rem;\n  resize: vertical;\n  padding: 0.65rem 0.75rem;\n  border: 0;\n  border-radius: inherit;\n  outline: 0;\n  background: transparent;\n  color: var(--cw-text);\n  line-height: 1.45;\n}\n.conventional-composer textarea:focus,\n.conventional-composer textarea:focus-visible {\n  outline: none;\n  box-shadow: none;\n}\n.conventional-composer:has(textarea:focus) {\n  outline: 3px solid var(--cw-focus);\n  outline-offset: 2px;\n}\n.conventional-composer__attachment-control {\n  position: relative;\n}\n.conventional-composer__attachments {\n  display: flex;\n  flex-wrap: wrap;\n  gap: 0.35rem;\n  padding: 0.45rem;\n  border-bottom: 1px solid var(--cw-border);\n}\n.conventional-composer__attachments > span {\n  display: inline-flex;\n  align-items: center;\n  gap: 0.35rem;\n  padding: 0.3rem 0.45rem;\n  border-radius: 0.35rem;\n  background: var(--cw-accent-soft);\n  font-size: 0.75rem;\n}\n.conventional-composer__attachments button {\n  display: grid;\n  width: 1.3rem;\n  height: 1.3rem;\n  place-items: center;\n  border: 0;\n  background: transparent;\n}\n.conventional-mention-menu {\n  min-width: 15rem;\n  max-height: 14rem;\n  overflow: auto;\n  padding: 0.35rem;\n  border: 1px solid var(--cw-border);\n  border-radius: 0.5rem;\n  background: var(--cw-surface);\n  box-shadow: var(--shadow-lg);\n}\n.conventional-attachment-menu {\n  position: absolute;\n  z-index: 8;\n  bottom: calc(100% + 0.25rem);\n  left: 0;\n  min-width: 15rem;\n  max-height: 14rem;\n  overflow: auto;\n  padding: 0.35rem;\n  border: 1px solid var(--cw-border);\n  border-radius: 0.5rem;\n  background: var(--cw-surface);\n  box-shadow: var(--shadow-lg);\n}\n.conventional-mention-menu button {\n  display: flex;\n  width: 100%;\n  min-height: 2.5rem;\n  align-items: center;\n  gap: 0.5rem;\n  padding: 0 0.55rem;\n  border: 0;\n  border-radius: 0.35rem;\n  background: transparent;\n  text-align: left;\n}\n.conventional-mention-menu button:hover {\n  background: var(--cw-surface-muted);\n}\n.conventional-attachment-menu {\n  bottom: calc(100% + 0.35rem);\n  display: grid;\n  gap: 0.2rem;\n}\n.conventional-attachment-menu label {\n  display: grid;\n  grid-template-columns: auto 1fr auto;\n  gap: 0.5rem;\n  align-items: center;\n  min-height: 2.5rem;\n  padding: 0 0.4rem;\n}\n.conventional-attachment-menu small {\n  color: var(--cw-muted);\n}\n.conventional-composer__status {\n  min-height: 0;\n}\n.conventional-composer__status p {\n  padding: 0.35rem 0.65rem;\n  color: var(--cw-danger);\n  font-size: 0.75rem;\n}\n.conventional-composer__status p.conventional-composer__status--muted {\n  color: var(--cw-muted);\n}\n.conventional-thread {\n  grid-column: 2;\n  grid-row: 1 / -1;\n  min-width: 0;\n  width: auto;\n}\n.conventional-thread > [role='region'] {\n  padding: 0.75rem clamp(0.5rem, 2vw, 1rem);\n}\n.conventional-directory {\n  height: 100%;\n  overflow: auto;\n  padding: clamp(1rem, 3vw, 2.5rem);\n}\n.conventional-tasks {\n  display: flex;\n  flex-direction: column;\n  height: 100%;\n  min-height: 0;\n  overflow: hidden;\n  padding: clamp(1rem, 3vw, 2.5rem);\n}\n.conventional-surface-header {\n  display: flex;\n  max-width: 78rem;\n  align-items: flex-start;\n  justify-content: space-between;\n  gap: 1rem;\n  margin: 0 auto 1.5rem;\n}\n.conventional-surface-header h1 {\n  font-size: clamp(1.5rem, 3vw, 2.1rem);\n}\n.conventional-surface-header p {\n  margin-top: 0.3rem;\n  color: var(--cw-muted);\n}\n.conventional-agent-grid {\n  display: grid;\n  grid-template-columns: repeat(auto-fill, minmax(17rem, 1fr));\n  gap: 0.8rem;\n  max-width: 78rem;\n  margin: auto;\n}\n.conventional-task-board {\n  flex: 1;\n  width: 100%;\n  max-width: 94rem;\n  min-height: 0;\n  margin: auto;\n}\n.conventional-task-card__footer-action {\n  margin-left: auto;\n}\n.conventional-task-card__kind {\n  display: inline-flex;\n  flex-shrink: 0;\n  align-items: center;\n  margin-top: 0.1rem;\n  color: var(--cw-muted);\n}\n.conventional-task-card__kind svg {\n  width: 0.9rem;\n  height: 0.9rem;\n}\n.conventional-task-board__error {\n  max-width: 94rem;\n  margin: 0 auto;\n  color: var(--cw-danger);\n  font-size: 0.8rem;\n}\n.conventional-task-card__objective {\n  display: -webkit-box;\n  overflow: hidden;\n  color: var(--cw-muted);\n  font-size: 0.8rem;\n  -webkit-box-orient: vertical;\n  -webkit-line-clamp: 2;\n}\n.conventional-task-card__metadata {\n  display: flex;\n  flex-wrap: wrap;\n  gap: 0.35rem;\n  color: var(--cw-muted);\n  font-size: 0.68rem;\n}\n.conventional-task-card__metadata span {\n  display: inline-flex;\n  align-items: center;\n  gap: 0.25rem;\n  padding: 0.15rem 0.3rem;\n  border-radius: 0.25rem;\n  background: var(--cw-surface-muted);\n}\n.conventional-task-card__metadata span svg {\n  width: 0.75rem;\n  height: 0.75rem;\n  flex: none;\n}\n.conventional-task-card__header {\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  gap: 0.5rem;\n}\n.conventional-dependency-results {\n  display: grid;\n  gap: 0.15rem;\n  max-height: 12rem;\n  overflow-y: auto;\n  margin: 0.5rem 0 0;\n  padding: 0;\n  list-style: none;\n}\n.conventional-dependency-results button {\n  display: flex;\n  width: 100%;\n  align-items: center;\n  gap: 0.5rem;\n  padding: 0.45rem 0.55rem;\n  border: 1px solid transparent;\n  border-radius: 0.4rem;\n  background: transparent;\n  color: var(--cw-text);\n  font-size: 0.82rem;\n  text-align: left;\n}\n.conventional-dependency-results button:hover {\n  background: var(--cw-surface-muted);\n}\n.conventional-dependency-results button[aria-pressed='true'] {\n  border-color: var(--cw-accent);\n  background: var(--cw-accent-soft);\n  color: var(--cw-accent-strong);\n}\n.conventional-dependency-results button svg {\n  width: 0.9rem;\n  height: 0.9rem;\n  flex: none;\n}\n.conventional-dependency-results button span {\n  overflow: hidden;\n  min-width: 0;\n  flex: 1;\n  text-overflow: ellipsis;\n  white-space: nowrap;\n}\n.conventional-dependency-results__empty {\n  padding: 0.45rem 0.55rem;\n  color: var(--cw-muted);\n  font-size: 0.82rem;\n}\n.conventional-priority {\n  display: inline-flex;\n  flex-shrink: 0;\n  align-items: center;\n  justify-content: center;\n  padding: 0.3rem;\n  border-radius: 999px;\n  background: var(--cw-surface-muted);\n  color: var(--cw-muted);\n}\n.conventional-priority svg {\n  width: 0.75rem;\n  height: 0.75rem;\n}\n.conventional-priority--low {\n  background: var(--cw-surface-muted);\n  color: var(--cw-muted);\n}\n.conventional-priority--normal {\n  background: var(--cw-accent-soft);\n  color: var(--cw-accent-strong);\n}\n.conventional-priority--urgent {\n  background: var(--cw-danger);\n  @supports (color: color-mix(in lab, red, red)) {\n    background: color-mix(in srgb, var(--cw-danger) 12%, transparent);\n  }\n  color: var(--cw-danger);\n}\n.conventional-priority--high {\n  background: var(--cw-priority-high-tint);\n  @supports (color: color-mix(in lab, red, red)) {\n    background: color-mix(in srgb, var(--cw-priority-high-tint) 12%, transparent);\n  }\n  color: var(--cw-priority-high);\n}\n.conventional-detail-panel {\n  height: 100%;\n  overflow-y: auto;\n  padding: 1.2rem;\n  background: var(--cw-surface);\n}\n.conventional-task-detail-drawer__content {\n  width: min(29rem, 94vw);\n}\n.conventional-detail-panel > header {\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  gap: 0.75rem;\n  padding-bottom: 0.8rem;\n  border-bottom: 1px solid var(--cw-border);\n}\n.conventional-detail-panel__close {\n  display: grid;\n  width: 2rem;\n  height: 2rem;\n  flex: none;\n  place-items: center;\n  border-radius: 0.35rem;\n  color: var(--cw-muted);\n}\n.conventional-detail-panel__close:hover {\n  background: var(--cw-surface-muted);\n  color: var(--cw-text);\n}\n.conventional-detail-panel__close svg {\n  width: 1rem;\n  height: 1rem;\n}\n.conventional-detail-panel__divider {\n  height: 1px;\n  min-height: 1px;\n  margin: 1rem 0 0;\n  border: 0;\n  background: var(--border, var(--cw-border));\n}\n.conventional-detail-panel input:focus-visible,\n.conventional-detail-panel textarea:focus-visible,\n.conventional-detail-panel select:focus-visible,\n.conventional-detail-panel button:focus-visible {\n  outline: 2px solid var(--cw-focus);\n  outline-offset: 1px;\n}\n.conventional-detail-panel label,\n.conventional-inline-form label,\n.conventional-dialog-form label {\n  display: grid;\n  gap